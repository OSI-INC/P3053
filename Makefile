.build-impl: .build-pre
	${MAKE} -f Makefile-${CONF}.mk SUBPROJECTS=${SUBPROJECTS} .build-conf

.clean-impl: .clean-pre
	${MAKE} -f Makefile-${CONF}.mk SUBPROJECTS=${SUBPROJECTS} .clean-conf

.clobber-impl: .clobber-pre 
	${MAKE} SUBPROJECTS=${SUBPROJECTS} CONF=pic32mz_ef_sk clean

.all-impl: .all-pre 
	${MAKE} SUBPROJECTS=${SUBPROJECTS} CONF=pic32mz_ef_sk build

